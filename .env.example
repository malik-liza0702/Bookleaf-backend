# Copy to .env and fill in the blanks. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=bookleaf

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# New tickets per author; each one also starts a paid AI classification
TICKET_RATE_LIMIT_MAX=5
TICKET_RATE_LIMIT_WINDOW_MS=3600000

# Author reply flood protection (per author)
REPLY_RATE_LIMIT_MAX=20
REPLY_RATE_LIMIT_WINDOW_MS=900000

# --- AI (Google Gemini) ---
# Leave empty to run in degraded mode: tickets are classified by the rule-based
# fallback and drafts use the template starter reply.
GEMINI_API_KEY=
AI_CLASSIFY_MODEL=gemini-3.5-flash-lite
AI_DRAFT_MODEL=gemini-3.8-flash
# Per-attempt timeout and number of retries (with backoff) on 429/5xx/timeouts
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
